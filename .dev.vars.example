# Copy to .dev.vars for local development. In production, set each of these
# with `wrangler secret put <NAME>`.

# Newsletter (/api/subscribe, /api/verify)
LOOPS_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SVG paths comments (/api/comments)
POSTGRES_URL=

# GitHub sign-in for comments (/api/auth/*)
GITHUB_ID=
GITHUB_SECRET=
# Any long random string; used to sign the session cookie.
AUTH_SECRET=
